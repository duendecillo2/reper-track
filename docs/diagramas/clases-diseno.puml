@startuml
!pragma layout smetana
title ReperTrack - Diagrama de Clases de Diseño

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #1c5c3c
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F0F4F0

package model {
  class Musico {
    -musicoId : int
    -nombre : String
    -nivel : Nivel
    -estilo : String
    +getMusicoId() : int
    +getNombre() : String
    +setNombre(nombre : String)
  }

  class Instrumento {
    -instrumentoId : int
    -musico : Musico
    -nombre : String
    -tipo : TipoInstrumento
    -observaciones : String
    -activo : boolean
    +getInstrumentoId() : int
    +getMusico() : Musico
    +getNombre() : String
    +desactivar()
  }

  abstract class ElementoDeEstudio {
    -elementoId : int
    -nombre : String
    -instrumento : Instrumento
    -nivelDificultad : int
    -tiempoEstimadoDominioMin : int
    -activo : boolean
    +{abstract} calcularProgreso(min : int) : double
  }

  class Cancion {
    -autor : String
    -interpreteOriginal : String
    -tonalidad : String
    -compas : String
    +calcularProgreso(min : int) : double
  }

  class Ejercicio {
    -tipoEjercicio : TipoEjercicio
    -tempoSugeridoBPM : int
    +calcularProgreso(min : int) : double
  }

  class SesionDePractica {
    -sesionId : int
    -instrumento : Instrumento
    -elemento : ElementoDeEstudio
    -fechaRegistro : LocalDateTime
    -tiempoNetoMin : int
    -comentario : String
    +validar() : void
  }

  class Estadistica {
    -minutosPorInstrumento : Map
    -minutosPorElemento : Map
    -minutosPorDiaSemana : int[7]
    -totalSesiones : int
    +agregarMinutosInstrumento(id : int, min : long)
    +agregarMinutosDia(dia : int, min : int)
    +getMinutosPorDiaSemana() : int[]
    +estaVacia() : boolean
  }

  class Alerta {
    -elementoId : int
    -nombreElemento : String
    -ultimaPractica : LocalDate
    -diasSinPractica : int
    -motivo : String
  }

  enum Nivel {
    PRINCIPIANTE
    INTERMEDIO
    AVANZADO
  }
  enum TipoInstrumento {
    CUERDA
    VIENTO
    PERCUSION
    TECLADO
    OTRO
  }
  enum TipoEjercicio {
    ESCALA
    ARPEGIO
    ETUDE
    PATRON_RITMICO
  }
  enum CategoriaElemento {
    CANCION
    EJERCICIO
  }
}

package excepcion {
  class RangoInvalidoException
  class LongitudExcedidaException
  class SesionSinReferenciaException
  class ElementoInexistenteException
  class InstrumentoInexistenteException
  class PersistenciaException
  class ArchivoException
}

package util {
  class ConexionDB {
    +{static} obtenerConexion() : Connection
    +{static} mysqlDisponible() : boolean
  }
  class Validador {
    +{static} exigirRangoEntero(campo : String, v : int, min : int, max : int)
    +{static} exigirNoVacio(campo : String, v : String)
  }
}

package dao {
  interface InstrumentoDAO {
    +insertar(i : Instrumento) : void
    +obtener(id : int) : Instrumento
    +listar() : List
  }
  interface ElementoDAO {
    +insertar(e : ElementoDeEstudio) : void
    +listarPorInstrumento(id : int) : List
  }
  interface SesionDAO {
    +guardar(s : SesionDePractica) : int
    +listar() : List
    +acumuladoPorInstrumento() : Map
  }
  class InstrumentoDAOImpl
  class ElementoDAOImpl
  class SesionDAOImpl
}

package service {
  class SesionService {
    -dao : SesionDAO
    +registrarSesion(i : Instrumento, e : ElementoDeEstudio, min : int, c : String) : int
    +ordenarPorFechaDesc(lista : List) : List
  }
  class InstrumentoService
  class ElementoService {
    -undo : Pila
    +alta(e : ElementoDeEstudio) : void
  }
  class EstadisticaService {
    +calcular() : Estadistica
  }
  class MotorAlertasService {
    +calcular() : Cola
  }
  class ExportadorPdfService {
    +exportar(est : Estadistica, ruta : String) : void
  }
  class ExportadorTextoService {
    +exportar(est : Estadistica, ruta : String) : void
    +leer(ruta : String) : String
  }
}

package controlador {
  class MenuPrincipal {
    +iniciar() : void
    +mostrarMenu() : void
  }
  class SesionController
  class InstrumentoController
  class ElementoController
  class EstadisticaController
  class AlertaController
}

package estructuras {
  class ListaEnlazadaSimple
  class Pila
  class Cola
  class Busqueda
  class Ordenacion
}

Musico "1" *-- "0..*" Instrumento : posee
Instrumento "1" *-- "0..*" ElementoDeEstudio : agrupa
Musico "1" -- "0..*" SesionDePractica : registra
Instrumento "1" -- "0..*" SesionDePractica : utilizado en
ElementoDeEstudio "1" -- "0..*" SesionDePractica : aborda
ElementoDeEstudio <|-- Cancion
ElementoDeEstudio <|-- Ejercicio

InstrumentoDAO <|.. InstrumentoDAOImpl
ElementoDAO <|.. ElementoDAOImpl
SesionDAO <|.. SesionDAOImpl

InstrumentoService --> InstrumentoDAO
ElementoService --> ElementoDAO
SesionService --> SesionDAO
EstadisticaService --> SesionDAO
MotorAlertasService --> SesionDAO
MotorAlertasService --> Alerta : genera

MenuPrincipal --> SesionController
MenuPrincipal --> InstrumentoController
MenuPrincipal --> ElementoController
MenuPrincipal --> EstadisticaController
MenuPrincipal --> AlertaController

SesionController --> SesionService
ElementoController --> ElementoService
InstrumentoController --> InstrumentoService

note as N1
  Main y TestRunner son puntos de entrada
  (no forman parte del modelo de diseño).
  VistaSesion es legacy del TP2 y no
  participa del flujo actual.
end note
@enduml